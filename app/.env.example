# Copy this file to .env and fill in your own values. .env is gitignored.

# Your Apple ID email.
ICLOUD_USERNAME=you@icloud.com

# An app-specific password, not your normal Apple ID password.
# Generate one at https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords.
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional. Restricts reads to one calendar by name (e.g. "Home"), and is
# where new tasks are created. If unset, reads merge every calendar in the
# account and new tasks go to the first calendar found.
ICLOUD_CALENDAR_NAME=
